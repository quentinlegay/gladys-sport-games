  "name": "Sport Games",
  "description": {
    "en": "Schedule and results of your teams (NBA, EuroLeague, Betclic Élite, NM1), alerts and widget.",
    "fr": "Calendrier et résultats de vos équipes (NBA, EuroLeague, Betclic Élite, NM1), alertes et widget."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/quentinlegay/gladys-sport-games:1.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-sport-games/main/cover.png",
